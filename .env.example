# Copy this file to .env and set your secret Admin Portal credentials
VITE_ADMIN_USERNAME=your_admin_username
VITE_ADMIN_PASSWORD=your_secret_password

# For Vercel Live /admin Uploads (commits uploaded JSONs directly to GitHub so ALL devices see them)
GITHUB_TOKEN=ghp_your_github_personal_access_token
# Optional if deployed via Vercel Git integration (auto-detected on Vercel):
# GITHUB_REPO=your_github_username/your_repo_name
# GITHUB_BRANCH=main
